<Window x:Class="RiftSwitch.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RiftSwitch" Width="470" Height="700" MinWidth="400" MinHeight="500"
        WindowStyle="None" ResizeMode="CanResize" Background="Transparent"
        WindowStartupLocation="CenterScreen" Icon="/app.ico"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Fg}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" GlassFrameThickness="-1" ResizeBorderThickness="6" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- One saved account -->
        <DataTemplate x:Key="AccountCard">
            <Border x:Name="card" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="12" Padding="12,11" Margin="0,0,0,8" Cursor="Hand"
                    MouseLeftButtonUp="Card_Click" MouseRightButtonUp="Card_RightClick" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="lift"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="46"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Picture with a "signed in" dot -->
                    <Grid Width="46" Height="46" VerticalAlignment="Top">
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar}"/>
                        <Border Width="13" Height="13" CornerRadius="7" Background="{DynamicResource Good}" BorderThickness="2.5"
                                BorderBrush="{DynamicResource Bg}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Visibility="{Binding IsActive, Converter={StaticResource Vis}}"/>
                    </Grid>

                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" FontFamily="{StaticResource DisplayFont}" FontSize="15.5"
                                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="210" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Tag}" Background="{DynamicResource GoodSoft}" Margin="8,0,0,0"
                                    Visibility="{Binding IsActive, Converter={StaticResource Vis}}">
                                <TextBlock Text="Signed in" Style="{StaticResource TagText}" Foreground="{DynamicResource Good}"/>
                            </Border>
                            <Border Style="{StaticResource Tag}" Background="{DynamicResource WarnSoft}" Margin="8,0,0,0"
                                    Visibility="{Binding NeedsSignIn, Converter={StaticResource Vis}}"
                                    ToolTip="Its saved sign-in expired. Switch to it and sign in once with &quot;Stay signed in&quot; ticked.">
                                <TextBlock Text="Sign-in needed" Style="{StaticResource TagText}" Foreground="{DynamicResource Warn}"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding RiotId}" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,0,8,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170"
                                       Visibility="{Binding ShowRiotId, Converter={StaticResource Vis}}"/>
                            <Border Style="{StaticResource Tag}" Visibility="{Binding Region, Converter={StaticResource NullVis}}">
                                <TextBlock Text="{Binding Region}" Style="{StaticResource TagText}"/>
                            </Border>
                            <Border Style="{StaticResource Tag}" Visibility="{Binding LevelText, Converter={StaticResource NullVis}}">
                                <TextBlock Text="{Binding LevelText}" Style="{StaticResource TagText}"/>
                            </Border>
                        </StackPanel>

                        <!-- Ranks (filled in while League is open on this account) -->
                        <WrapPanel Margin="0,6,0,0" Visibility="{Binding HasRank, Converter={StaticResource Vis}}">
                            <Ellipse Width="8" Height="8" Fill="{Binding SoloBrush}" VerticalAlignment="Center" Margin="1,0,6,0"/>
                            <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding SoloBrush}" VerticalAlignment="Center"
                                       Text="{Binding Solo.Short}" ToolTip="{Binding Solo.Record}"/>
                            <TextBlock Text="Solo" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" Visibility="{Binding HasFlex, Converter={StaticResource Vis}}">
                                <TextBlock Text="·" Foreground="{DynamicResource Muted}" Margin="7,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding Flex.Short}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center"
                                           ToolTip="{Binding Flex.Record}"/>
                                <TextBlock Text="Flex" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center" Opacity="0.75"/>
                            </StackPanel>
                        </WrapPanel>

                        <TextBlock Text="{Binding Note}" Foreground="{DynamicResource Muted}" FontSize="12" FontStyle="Italic"
                                   Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                   Visibility="{Binding HasNote, Converter={StaticResource Vis}}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Style="{StaticResource Spinner}" Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource Vis}}"/>
                        <Button x:Name="switchBtn" Content="Switch" Style="{StaticResource PrimaryButton}" Padding="13,6" FontSize="12.5"
                                Click="Switch_Click" Opacity="0.0"
                                Visibility="{Binding IsActive, Converter={StaticResource NotVis}}"/>
                        <Button Content="&#xE712;" Style="{StaticResource IconButton}" Margin="4,0,0,0" Click="More_Click" ToolTip="More"/>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                    <Setter TargetName="card" Property="Background" Value="{DynamicResource AccentSoft}"/>
                </DataTrigger>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.15"
                                                 EasingFunction="{StaticResource EaseOut}"/>
                                <DoubleAnimation Storyboard.TargetName="switchBtn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="lift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.2"
                                                 EasingFunction="{StaticResource EaseOut}"/>
                                <DoubleAnimation Storyboard.TargetName="switchBtn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.2"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                    <Setter TargetName="card" Property="BorderBrush" Value="{DynamicResource Thumb}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Border Background="{DynamicResource Surface}">
        <Grid>
            <Grid x:Name="Page">
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title bar -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <Image Source="/app.ico" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="RiftSwitch" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"
                                   Margin="9,0,0,1" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="&#xE713;" Style="{StaticResource CaptionButton}" FontSize="13" Click="OpenSettings_Click"
                                ToolTip="Settings" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="Close_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>

                <!-- Status banners -->
                <StackPanel Grid.Row="1" Margin="16,4,16,0">
                    <Border x:Name="AddBanner" Background="{DynamicResource AccentSoft}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Style="{StaticResource Spinner}" VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <StackPanel Grid.Column="1" Margin="11,0,8,0">
                                <TextBlock Text="Waiting for you to sign in" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0">
                                    Sign in in the Riot Client and tick <Run FontWeight="SemiBold" Foreground="{DynamicResource Fg}">Stay signed in</Run>.
                                    The account is saved as soon as you're in.
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="2" Content="&#xE711;" Style="{StaticResource IconButton}" VerticalAlignment="Top"
                                    Click="CancelAdd_Click" ToolTip="Stop waiting"/>
                        </Grid>
                    </Border>
                    <Border x:Name="PersistBanner" Background="{DynamicResource WarnSoft}" CornerRadius="10" Padding="12,10" Margin="0,0,0,8"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Warn}" FontSize="15"
                                       VerticalAlignment="Top" Margin="0,1,0,0"/>
                            <StackPanel Margin="11,0,0,0" MaxWidth="360">
                                <TextBlock Text="This sign-in can't be saved" FontWeight="SemiBold"/>
                                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0">
                                    &quot;Stay signed in&quot; wasn't ticked. Use <Run FontWeight="SemiBold" Foreground="{DynamicResource Fg}">Add account</Run>
                                    and tick it when you sign in.
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Accounts -->
                <ScrollViewer Grid.Row="2" x:Name="ListScroll" VerticalScrollBarVisibility="Auto" Padding="16,4,10,8" Margin="0,0,6,0">
                    <ItemsControl x:Name="AccountList" ItemTemplate="{StaticResource AccountCard}" Focusable="False"/>
                </ScrollViewer>

                <!-- Empty state -->
                <StackPanel Grid.Row="2" x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="320"
                            Visibility="Collapsed">
                    <Grid Width="84" Height="84" HorizontalAlignment="Center">
                        <Ellipse Fill="{DynamicResource AccentSoft}"/>
                        <TextBlock Text="&#xE8AB;" FontFamily="{StaticResource Icons}" FontSize="34" Foreground="{DynamicResource Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="Add your first account" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,18,0,0"/>
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,8,0,0" LineHeight="19">
                        Sign in to each account once in the Riot Client with "Stay signed in" ticked.
                        After that, switching takes one click. Your passwords are never stored.
                    </TextBlock>
                    <Button Content="Add account" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0"
                            Padding="18,8" Click="Add_Click"/>
                </StackPanel>

                <!-- Footer -->
                <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource SecondaryButton}" Click="Add_Click" Padding="12,6">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE710;" FontFamily="{StaticResource Icons}" FontSize="11" VerticalAlignment="Center"/>
                                <TextBlock Text="Add account" Margin="7,0,0,0"/>
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Open League after switching">
                            <TextBlock Text="Open League" Foreground="{DynamicResource Muted}" FontSize="12.5" Margin="0,0,9,0" VerticalAlignment="Center"/>
                            <CheckBox x:Name="LaunchToggle" Style="{StaticResource Toggle}" Click="LaunchToggle_Click"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    x:Name="HotkeyHint" ToolTip="Quick switcher, from anywhere">
                            <ItemsControl x:Name="HotkeyKeys" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource KeyCap}" Margin="0,0,3,0">
                                            <TextBlock Text="{Binding}" Style="{StaticResource KeyCapText}"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Switching progress -->
            <Grid x:Name="BusyOverlay" Background="{DynamicResource Scrim}" Visibility="Collapsed" Opacity="0">
                <Border Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="16"
                        Padding="28,26" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="290">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.35" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <Grid Width="64" Height="64" HorizontalAlignment="Center">
                            <ContentPresenter x:Name="BusyAvatar" ContentTemplate="{StaticResource Avatar}" Margin="6"/>
                            <Path Style="{StaticResource Spinner}" Width="64" Height="64" StrokeThickness="2"/>
                        </Grid>
                        <TextBlock x:Name="BusyTitle" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                        <TextBlock x:Name="BusyStep" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Edit sheet -->
            <Grid x:Name="EditOverlay" Background="{DynamicResource Scrim}" Visibility="Collapsed" MouseLeftButtonDown="EditScrim_Click">
                <Border x:Name="EditSheet" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1,1,1,0"
                        CornerRadius="16,16,0,0" VerticalAlignment="Bottom" Padding="20,18,20,18" MouseLeftButtonDown="Sheet_MouseDown">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="EditSlide"/>
                    </Border.RenderTransform>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ContentPresenter x:Name="EditAvatar" ContentTemplate="{StaticResource Avatar}" Width="40" Height="40"/>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Edit account" FontFamily="{StaticResource DisplayFont}" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock x:Name="EditRiotId" Foreground="{DynamicResource Muted}" FontSize="12.5"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Nickname" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,18,0,6"/>
                        <TextBox x:Name="EditLabel" Style="{StaticResource Field}" Tag="e.g. Main, Smurf, Duo account" MaxLength="40"
                                 KeyDown="EditField_KeyDown"/>

                        <TextBlock Text="Color" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,14,0,6"/>
                        <ItemsControl x:Name="EditColors" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <TextBlock Text="Note" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,14,0,6"/>
                        <TextBox x:Name="EditNote" Style="{StaticResource Field}" Tag="Anything to remember (shown on the card)"
                                 MaxLength="140" TextWrapping="Wrap" AcceptsReturn="False" KeyDown="EditField_KeyDown"/>

                        <!-- Normal buttons -->
                        <Grid x:Name="EditButtons" Margin="0,20,0,0">
                            <Button Style="{StaticResource LinkButton}" Foreground="{DynamicResource Bad}" HorizontalAlignment="Left"
                                    VerticalAlignment="Center" Click="RemoveAsk_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Icons}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Remove account" Margin="6,0,0,0"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="EditCancel_Click"/>
                                <Button Content="Save" Style="{StaticResource PrimaryButton}" MinWidth="80" Click="EditSave_Click"/>
                            </StackPanel>
                        </Grid>
                        <!-- Remove confirmation -->
                        <Border x:Name="RemoveConfirm" Background="{DynamicResource BadSoft}" CornerRadius="10" Padding="12,10" Margin="0,20,0,0"
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RemoveText" TextWrapping="Wrap" VerticalAlignment="Center" FontSize="12.5"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                    <Button Content="Keep" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0" Click="RemoveCancel_Click"/>
                                    <Button Content="Remove" Style="{StaticResource DangerButton}" Click="RemoveConfirm_Click"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Settings page -->
            <Grid x:Name="SettingsPage" Visibility="Collapsed" Background="{DynamicResource Bg}">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SettingsSlide"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                        <Button Content="&#xE72B;" Style="{StaticResource IconButton}" Click="CloseSettings_Click" ToolTip="Back"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <TextBlock Text="Settings" FontFamily="{StaticResource DisplayFont}" FontWeight="SemiBold" FontSize="14"
                                   Margin="8,0,0,1" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="Minimize_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                        <Button Content="&#xE8BB;" Style="{StaticResource CloseButton}" Click="Close_Click"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20,6,14,20" Margin="0,0,6,0">
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style x:Key="Section" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="Margin" Value="2,18,0,8"/>
                            </Style>
                            <Style x:Key="Row" TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource Card}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="CornerRadius" Value="10"/>
                                <Setter Property="Padding" Value="14,12"/>
                                <Setter Property="Margin" Value="0,0,0,6"/>
                            </Style>
                            <Style x:Key="RowTitle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="13.5"/>
                            </Style>
                            <Style x:Key="RowHint" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12"/>
                                <Setter Property="Foreground" Value="{DynamicResource Muted}"/>
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Margin" Value="0,2,0,0"/>
                            </Style>
                        </StackPanel.Resources>

                        <TextBlock Text="SWITCHING" Style="{StaticResource Section}" Margin="2,4,0,8"/>
                        <Border Style="{StaticResource Row}">
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="Open League after switching" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Off: only the Riot Client opens, signed in to the account." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox x:Name="SetLaunch" Style="{StaticResource Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Click="SettingToggle_Click"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <Grid>
                                <StackPanel Margin="0,0,130,0">
                                    <TextBlock Text="Quick switcher shortcut" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Opens a small account picker from anywhere. Press 1-9 or Enter to switch." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <Button x:Name="HotkeyButton" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        MinWidth="120" Click="HotkeyButton_Click" PreviewKeyDown="HotkeyButton_KeyDown" LostKeyboardFocus="HotkeyButton_LostFocus"/>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="HotkeyError" Foreground="{DynamicResource Bad}" FontSize="12" Margin="4,0,0,6" Visibility="Collapsed"/>

                        <TextBlock Text="APP" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Row}">
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="Start with Windows" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Starts quietly in the tray so the shortcut always works." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox x:Name="SetStartup" Style="{StaticResource Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Click="SettingToggle_Click"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="Keep running when closed" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Closing the window keeps RiftSwitch in the tray. Off: closing quits." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox x:Name="SetTray" Style="{StaticResource Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Click="SettingToggle_Click"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Text="Theme" Style="{StaticResource RowTitle}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <RadioButton x:Name="ThemeSystem" Content="Follow Windows" Style="{StaticResource Chip}" GroupName="theme" Click="Theme_Click"/>
                                    <RadioButton x:Name="ThemeDark" Content="Dark" Style="{StaticResource Chip}" GroupName="theme" Click="Theme_Click"/>
                                    <RadioButton x:Name="ThemeLight" Content="Light" Style="{StaticResource Chip}" GroupName="theme" Click="Theme_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="UPDATES" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Row}">
                            <Grid>
                                <StackPanel Margin="0,0,56,0">
                                    <TextBlock Text="Update automatically" Style="{StaticResource RowTitle}"/>
                                    <TextBlock Text="Checks GitHub every few hours and installs while RiftSwitch is idle." Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <CheckBox x:Name="SetUpdate" Style="{StaticResource Toggle}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          Click="SettingToggle_Click"/>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Row}">
                            <Grid>
                                <StackPanel Margin="0,0,110,0">
                                    <TextBlock x:Name="VersionText" Style="{StaticResource RowTitle}"/>
                                    <TextBlock x:Name="UpdateStatus" Style="{StaticResource RowHint}"/>
                                </StackPanel>
                                <Button x:Name="UpdateButton" Content="Check now" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Click="CheckUpdate_Click"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="GOOD TO KNOW" Style="{StaticResource Section}"/>
                        <Border Style="{StaticResource Row}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource RowHint}" Margin="0" LineHeight="18">
                                    <Run FontWeight="SemiBold" Foreground="{DynamicResource Fg}">Passwords are never stored.</Run>
                                    RiftSwitch keeps a copy of each account's "Stay signed in" session, encrypted so only your Windows user can read it.
                                </TextBlock>
                                <TextBlock Style="{StaticResource RowHint}" Margin="0,8,0,0" LineHeight="18">
                                    <Run FontWeight="SemiBold" Foreground="{DynamicResource Fg}">Don't use "Sign out" in the Riot Client.</Run>
                                    It ends the saved session on Riot's side, and you'd have to sign in to that account again. Switch with RiftSwitch instead.
                                </TextBlock>
                                <TextBlock Style="{StaticResource RowHint}" Margin="0,8,0,0" LineHeight="18">
                                    <Run FontWeight="SemiBold" Foreground="{DynamicResource Fg}">Ranks and levels</Run>
                                    fill in while League is open on an account.
                                </TextBlock>
                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Click="OpenFolder_Click">
                                    <TextBlock Text="Open RiftSwitch's data folder" FontSize="12.5"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Toast -->
            <Border x:Name="Toast" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="12" Padding="14,11" Margin="16,0,16,70" VerticalAlignment="Bottom" HorizontalAlignment="Center"
                    MaxWidth="420" Visibility="Collapsed" Opacity="0" IsHitTestVisible="True" MouseLeftButtonUp="Toast_Click">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="22" ShadowDepth="4" Opacity="0.35" Color="Black"/>
                </Border.Effect>
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ToastSlide"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="26" Height="26" VerticalAlignment="Top">
                        <Ellipse x:Name="ToastDot"/>
                        <TextBlock x:Name="ToastIcon" FontFamily="{StaticResource Icons}" FontSize="12" HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="11,0,4,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ToastTitle" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock x:Name="ToastText" Foreground="{DynamicResource Muted}" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
