<Window x:Class="RiftSwitch.QuickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="RiftSwitch quick switch" Width="420" SizeToContent="Height" MaxHeight="560"
        WindowStyle="None" ResizeMode="NoResize" Background="Transparent" ShowInTaskbar="False" Topmost="True"
        FontFamily="{StaticResource UiFont}" Foreground="{DynamicResource Fg}" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Border Background="{DynamicResource Surface}">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.3">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Pop"/>
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Search -->
            <Grid Margin="14,12,14,8">
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource Icons}" Foreground="{DynamicResource Muted}" FontSize="14"
                           VerticalAlignment="Center" Margin="4,0,0,0"/>
                <TextBox x:Name="Search" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Fg}"
                         CaretBrush="{DynamicResource Fg}" FontSize="15" Margin="28,0,0,0" Padding="0,4" VerticalAlignment="Center"
                         TextChanged="Search_TextChanged" PreviewKeyDown="Search_KeyDown"/>
                <TextBlock x:Name="SearchHint" Text="Switch account…" Foreground="{DynamicResource Muted}" FontSize="15"
                           Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <Border Grid.Row="1" Height="1" Background="{DynamicResource Line}"/>

            <!-- Accounts -->
            <ListBox Grid.Row="2" x:Name="List" Background="Transparent" Foreground="{DynamicResource Fg}" BorderThickness="0" Padding="6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MaxHeight="430" Focusable="False"
                     MouseLeftButtonUp="List_Click">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Foreground" Value="{DynamicResource Fg}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="b" Background="Transparent" CornerRadius="9" Padding="10,8" Margin="0,1" Cursor="Hand">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Hover}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="b" Property="Background" Value="{DynamicResource Selected}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KeyCap}" Width="20" Margin="0,0,10,0"
                                    Visibility="{Binding SlotText, Converter={StaticResource NullVis}}">
                                <TextBlock Text="{Binding SlotText}" Style="{StaticResource KeyCapText}"/>
                            </Border>
                            <Grid Grid.Column="1" Width="34" Height="34">
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource Avatar}"/>
                                <Border Width="11" Height="11" CornerRadius="6" Background="{DynamicResource Good}" BorderThickness="2"
                                        BorderBrush="{DynamicResource Bg}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Visibility="{Binding IsActive, Converter={StaticResource Vis}}"/>
                            </Grid>
                            <StackPanel Grid.Column="2" Margin="11,0,8,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="  ·  signed in" Foreground="{DynamicResource Good}" FontSize="12"
                                               Visibility="{Binding IsActive, Converter={StaticResource Vis}}" VerticalAlignment="Center"/>
                                    <TextBlock Text="  ·  sign-in needed" Foreground="{DynamicResource Warn}" FontSize="12"
                                               Visibility="{Binding NeedsSignIn, Converter={StaticResource Vis}}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,1,0,0">
                                    <TextBlock Text="{Binding RiotId}" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Region, StringFormat='  ·  {0}'}" Foreground="{DynamicResource Muted}" FontSize="12"
                                               Visibility="{Binding Region, Converter={StaticResource NullVis}}"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right"
                                        Visibility="{Binding HasRank, Converter={StaticResource Vis}}">
                                <TextBlock Text="{Binding Solo.TierName}" Foreground="{Binding SoloBrush}" FontWeight="SemiBold" FontSize="12"
                                           HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding Solo.LpLine}" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Empty -->
            <StackPanel Grid.Row="2" x:Name="Empty" Margin="20,26" Visibility="Collapsed">
                <TextBlock x:Name="EmptyTitle" Text="No accounts yet" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <TextBlock x:Name="EmptyText" Text="Open RiftSwitch to add one." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Footer: hints, or progress while switching -->
            <Border Grid.Row="3" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,9">
                <Grid>
                    <StackPanel x:Name="Hints" Orientation="Horizontal">
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="&#xE74A;" Style="{StaticResource KeyCapIcon}"/></Border>
                        <Border Style="{StaticResource KeyCap}" Margin="3,0,0,0"><TextBlock Text="&#xE74B;" Style="{StaticResource KeyCapIcon}"/></Border>
                        <TextBlock Text="Select" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="6,0,14,0" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="Enter" Style="{StaticResource KeyCapText}"/></Border>
                        <TextBlock Text="or" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="5,0" VerticalAlignment="Center"/>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="1-9" Style="{StaticResource KeyCapText}"/></Border>
                        <TextBlock Text="Switch" Foreground="{DynamicResource Muted}" FontSize="11.5" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="OpenLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Click="Open_Click">
                        <TextBlock Text="Open RiftSwitch" FontSize="12"/>
                    </Button>
                    <StackPanel x:Name="Status" Orientation="Horizontal" Visibility="Collapsed">
                        <Grid Width="18" Height="18">
                            <Path x:Name="StatusSpin" Style="{StaticResource Spinner}" Width="16" Height="16"/>
                            <TextBlock x:Name="StatusIcon" FontFamily="{StaticResource Icons}" FontSize="13" HorizontalAlignment="Center"
                                       VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Grid>
                        <TextBlock x:Name="StatusText" Margin="9,0,0,0" VerticalAlignment="Center" FontSize="12.5" TextTrimming="CharacterEllipsis"
                                   MaxWidth="350"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
