<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RiftSwitch</AssemblyName>
    <RootNamespace>RiftSwitch</RootNamespace>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- Release version. Bumped by release.ps1; GitHub builds pass the tag version in. -->
    <Version>1.1.3</Version>
    <Product>RiftSwitch</Product>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <!-- WinForms is only used by name in Tray.cs; keep its types out of the global namespace. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="app.ico" />
  </ItemGroup>

</Project>
